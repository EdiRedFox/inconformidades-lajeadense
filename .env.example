# Copie este arquivo para .env e preencha os valores localmente.
# Nunca coloque chaves privadas reais neste arquivo ou no Git.

DATA_STORE=

GOOGLE_SERVICE_ACCOUNT_EMAIL=seu-service-account@seu-projeto.iam.gserviceaccount.com

# Use \\n para representar quebras de linha na chave privada.
# Somente o ID entre /d/ e /edit, não a URL completa.
GOOGLE_SHEET_ID=SEU_ID_DA_PLANILHA
GOOGLE_SHEET_TAB=Registros
GOOGLE_DRIVE_FOLDER_ID=

# Acessos do painel administrativo. Use valores fortes em produção.
ADMIN_USER_1=admin-1
ADMIN_PASSWORD_1=troque-esta-senha
ADMIN_USER_2=admin-2
ADMIN_PASSWORD_2=troque-esta-senha
ADMIN_SESSION_SECRET=troque-por-um-segredo-longo
